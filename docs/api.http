GET {{baseUrl}}/me

########################################################################################################################
# Report example 6.1 through the API
#
# Mehmet Karaca publishes 5 packages of 120 TL for 60 TL at Karaca Fırını Kızılay Şubesi with a pickup window that
# opens 2 minutes later; Ahmet Yılmaz buys 2, so 3 remain; after the window opens Mehmet Karaca verifies the code and
# Ahmet Yılmaz rates the order.
########################################################################################################################

### Fetch the CSRF token
GET {{baseUrl}}/auth/csrf

> {%
    const token = (response.headers.valuesOf("Set-Cookie") || [])
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.split(";")[0].substring("XSRF-TOKEN=".length))
        .filter(v => v.length > 0)
        .pop();
    if (token) {
        client.global.set("xsrf", token);
    }
%}

### Sign in as the bakery owner Mehmet Karaca (also sets the pickup window: now + 2 minutes to now + 62 minutes)
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "email": "{{bakeryOwnerEmail}}",
  "password": "{{demoPassword}}"
}

> {%
    const token = (response.headers.valuesOf("Set-Cookie") || [])
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.split(";")[0].substring("XSRF-TOKEN=".length))
        .filter(v => v.length > 0)
        .pop();
    if (token) {
        client.global.set("xsrf", token);
    }
    const pad = n => String(n).padStart(2, "0");
    const local = d => d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + "T"
        + pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":00";
    const start = new Date(Date.now() + 2 * 60 * 1000);
    client.global.set("examplePickupStart", local(start));
    client.global.set("examplePickupEnd", local(new Date(start.getTime() + 60 * 60 * 1000)));
%}

### Find Karaca Fırını Kızılay Şubesi through its live listing
GET {{baseUrl}}/listings?city=Ankara&district=Çankaya&type=FIRIN

> {%
    const item = response.body.items.find(i => i.businessName === "Karaca Fırını Kızılay Şubesi");
    if (item) {
        client.global.set("exampleBusinessId", item.businessId);
    }
%}

### Publish 5 packages: normal price 120.00, sale price 60.00
POST {{baseUrl}}/businesses/{{exampleBusinessId}}/listings
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "title": "Karışık Unlu Mamul Paketi",
  "description": "Ekmek, poğaça ve açma karışık paket.",
  "allergenInfo": "Gluten, süt, yumurta içerir.",
  "normalPrice": "120.00",
  "salePrice": "60.00",
  "totalQuantity": 5,
  "pickupStart": "{{examplePickupStart}}",
  "pickupEnd": "{{examplePickupEnd}}"
}

> {%
    if (response.status === 201) {
        client.global.set("exampleListingId", response.body.id);
    }
%}

