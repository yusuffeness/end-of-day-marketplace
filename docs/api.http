X-XSRF-TOKEN: {{xsrf}}

### Inspect the active listings (stores the first one)
GET {{baseUrl}}/admin/listings?status=AKTIF

> {%
    if (response.status === 200 && response.body.items.length > 0) {
        client.global.set("inspectedListingId", response.body.items[0].id);
    }
%}

### Deactivate a listing that breaks the platform rules
POST {{baseUrl}}/admin/listings/{{inspectedListingId}}/deactivate
X-XSRF-TOKEN: {{xsrf}}

### Revoke the own administrator role: 409 EOD-028
DELETE {{baseUrl}}/admin/users/{{adminId}}/roles/YONETICI
X-XSRF-TOKEN: {{xsrf}}

### Platform report of October 2026 (read as eod_report from the views)
GET {{baseUrl}}/admin/reports/platform?from=2026-10-01&to=2026-10-31

### Sign out
POST {{baseUrl}}/auth/logout
X-XSRF-TOKEN: {{xsrf}}
