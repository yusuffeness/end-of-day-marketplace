### Runnable examples of every endpoint in api.md, using the demo data of the dev profile.
#
# Tools: the IntelliJ HTTP Client, or the httpyac extension in VS Code. Both keep cookies between requests and run the
# "> {% ... %}" response handlers that store the CSRF token and the ids used by later requests. The VS Code REST Client
# extension does not run these handlers, so its state-changing requests fail with 403 EOD-403.
#
# Start the backend with the dev profile on a freshly reset database (see "Demo data" in the README) and run the
# requests from top to bottom. The live demo listings and the open demo order are valid for a few hours after the
# database was loaded. The client machine is assumed to use the Istanbul time zone, like the server.
#
# State-changing requests need the CSRF token: the XSRF-TOKEN cookie set by the server is sent back in the
# X-XSRF-TOKEN header. The handlers below store the current token in the variable xsrf. Sign-in replaces the token
# and sign-out clears it, so "Fetch the CSRF token" is run again after every sign-out.
#
# Requests whose title names a status and a code show the answer the rule gives, for example 409 EOD-005.

@baseUrl = http://localhost:8080/api/v1
@demoPassword = GunSonu2026!
@customerEmail = ahmet.yilmaz@ornek.test
@ownerEmail = can.dogan@ornek.test
@bakeryOwnerEmail = mehmet.karaca@ornek.test
@adminEmail = selin.aydemir@ornek.test

########################################################################################################################
# Authentication and account
########################################################################################################################

### Fetch the CSRF token
GET {{baseUrl}}/auth/csrf

> {%
    const token = (response.headers.valuesOf("Set-Cookie") || [])
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.split(";")[0].substring("XSRF-TOKEN=".length))
        .filter(v => v.length > 0)
        .pop();
    if (token) {
        client.global.set("xsrf", token);
    }
%}

### Register a new customer account (the timestamp keeps the address unique on every run)
POST {{baseUrl}}/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "firstName": "Deniz",
  "lastName": "Yeni",
  "email": "deniz.{{$timestamp}}@ornek.test",
  "phone": "0532 000 00 00",
  "password": "parola123"
}

### Register again with a demo address: 409 EOD-009
POST {{baseUrl}}/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "firstName": "Ahmet",
  "lastName": "Yılmaz",
  "email": "AHMET.YILMAZ@ornek.test",
  "password": "parola123"
}

### Sign in with a wrong password: 401 EOD-010
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "email": "{{customerEmail}}",
  "password": "yanlisParola1"
}

### Sign in as the demo customer Ahmet Yılmaz
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "email": "{{customerEmail}}",
  "password": "{{demoPassword}}"
}

> {%
    const token = (response.headers.valuesOf("Set-Cookie") || [])
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.split(";")[0].substring("XSRF-TOKEN=".length))
        .filter(v => v.length > 0)
        .pop();
    if (token) {
        client.global.set("xsrf", token);
    }
%}

### Show the signed-in account
GET {{baseUrl}}/me

### Update the name and phone number (the demo values are written back unchanged)
PUT {{baseUrl}}/me
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "firstName": "Ahmet",
  "lastName": "Yılmaz",
  "phone": "0533 520 00 01"
}

### Change the password
PUT {{baseUrl}}/me/password
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "currentPassword": "{{demoPassword}}",
  "newPassword": "yeniParola456"
}

### Change the password back to the demo password
PUT {{baseUrl}}/me/password
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "currentPassword": "yeniParola456",
  "newPassword": "{{demoPassword}}"
}

### Change the password with a wrong current password: 400 EOD-012
PUT {{baseUrl}}/me/password
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "currentPassword": "yanlisParola1",
  "newPassword": "yeniParola456"
}

### A state-changing request without the CSRF header: 403 EOD-403
PUT {{baseUrl}}/me
Content-Type: application/json

{
  "firstName": "Ahmet",
  "lastName": "Yılmaz",
  "phone": "0533 520 00 01"
}

########################################################################################################################
# Customer: listings, orders and a business application, still signed in as Ahmet Yılmaz
########################################################################################################################

### Purchasable bakery listings in Ankara up to 100 TL (stores the first one for the next requests)
GET {{baseUrl}}/listings?city=Ankara&type=FIRIN&minPrice=10.00&maxPrice=100.00&page=0&size=20

> {%
    if (response.status === 200 && response.body.items.length > 0) {
        client.global.set("listingId", response.body.items[0].id);
        client.global.set("businessId", response.body.items[0].businessId);
    }
%}

### Invalid price range: 400 EOD-400
GET {{baseUrl}}/listings?minPrice=100.00&maxPrice=10.00

### Show the listing: description, allergens, prices, stock, address and pickup window
GET {{baseUrl}}/listings/{{listingId}}

### Place an order with the simulated payment
POST {{baseUrl}}/orders
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "businessId": {{businessId}},
  "items": [
    { "listingId": {{listingId}}, "quantity": 1 }
  ],
  "requestId": "demo-siparis-{{$timestamp}}",
  "simulatePaymentFailure": false
}

> {%
    if (response.status === 201) {
        client.global.set("orderId", response.body.id);
    }
%}

### Place an order whose payment is declined: 402 EOD-017, nothing is stored
POST {{baseUrl}}/orders
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "businessId": {{businessId}},
  "items": [
    { "listingId": {{listingId}}, "quantity": 1 }
  ],
  "requestId": "demo-red-{{$timestamp}}",
  "simulatePaymentFailure": true
}

### Order more units than are left: 409 EOD-014
POST {{baseUrl}}/orders
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "businessId": {{businessId}},
  "items": [
    { "listingId": {{listingId}}, "quantity": 100 }
  ],
  "requestId": "demo-stok-{{$timestamp}}"
}

### List my orders, newest first
GET {{baseUrl}}/orders?page=0&size=20

### Show the new order with its pickup code, canCancel and canReview
GET {{baseUrl}}/orders/{{orderId}}

### Cancel with a declined refund: 402 EOD-020, the refund is kept as BASARISIZ and the order stays confirmed
POST {{baseUrl}}/orders/{{orderId}}/cancel
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "requestId": "demo-iade-red-{{$timestamp}}",
  "simulateRefundFailure": true
}

### Cancel the new order before its pickup window starts (full refund, stock returned once)
POST {{baseUrl}}/orders/{{orderId}}/cancel
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "requestId": "demo-iptal-{{$timestamp}}",
  "simulateRefundFailure": false
}

### Cancel the cancelled order again with a new request id: 409 EOD-005
POST {{baseUrl}}/orders/{{orderId}}/cancel
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "requestId": "demo-iptal-tekrar-{{$timestamp}}"
}

### My delivered orders (stores one that is already reviewed, canReview false)
GET {{baseUrl}}/orders?status=TESLIM_EDILDI

> {%
    const reviewed = response.body.items.find(i => i.review !== null);
    if (reviewed) {
        client.global.set("deliveredOrderId", reviewed.id);
    }
%}

### Review a delivered demo order that already has a review: 409 EOD-024
POST {{baseUrl}}/orders/{{deliveredOrderId}}/review
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "rating": 5,
  "comment": "Çok taze ve lezzetliydi."
}

