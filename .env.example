# Host port that the MySQL container is published on
MYSQL_PORT=3306

# Password of the MySQL root account (administration only)
MYSQL_ROOT_PASSWORD=change-me-root

# Password of eod_owner, which owns the end_of_day schema and runs Flyway migrations
EOD_OWNER_PASSWORD=change-me-owner

# Password of eod_app, the account the application uses at runtime
EOD_APP_PASSWORD=change-me-app

# Password of eod_report, the read-only account for reporting views
EOD_REPORT_PASSWORD=change-me-report
